APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Web live-stream (Chats/Show) needs Reverb: set this to `reverb` and fill
# the REVERB_* block at the bottom. CLI-only use can stay on `log`.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -------------------------------------------------------------------
# Cortex - AI provider keys (REQUIRED: at least one provider)
# Seeded into ai_providers.api_key on `php artisan db:seed`.
# The CORTEX_ prefix is deliberate: it avoids collision with an
# ambient empty ANTHROPIC_API_KEY / OPENAI_API_KEY that many shells
# already export. More providers = more model diversity per boardroom.
# -------------------------------------------------------------------
CORTEX_ANTHROPIC_API_KEY=
CORTEX_OPENAI_API_KEY=
CORTEX_XAI_API_KEY=
CORTEX_GOOGLE_API_KEY=
CORTEX_MISTRAL_API_KEY=
CORTEX_DEEPSEEK_API_KEY=

# All other Cortex knobs (panel/router/fallback models, budgets,
# margins, free-credit amounts, API rate limits, languages) have sane
# defaults in config/cortex.php and are overridable via CORTEX_* env
# vars. See that file for the full list - you rarely need to set them.

# -------------------------------------------------------------------
# Reverb (WebSockets) - powers the live web boardroom stream (Chats/Show).
# Set app id/key/secret to any random strings, or run
# `php artisan install:broadcasting`. Then flip BROADCAST_CONNECTION
# above to `reverb` and run `php artisan reverb:start`.
# Not needed for CLI-only (`cortex:discuss`) use.
# -------------------------------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
